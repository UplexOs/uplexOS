{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uplexos.local/schemas/handoff.schema.json",
  "title": "UplexOS Handoff",
  "type": "object",
  "required": ["schema_version", "handoff_id", "execution_id", "project_id", "from", "to", "status", "artifacts", "decisions", "risks", "limitations", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "handoff_id": { "type": "string" },
    "execution_id": { "type": "string" },
    "project_id": { "type": "string" },
    "from": { "type": "string" },
    "to": { "type": "string" },
    "status": { "const": "ready" },
    "artifacts": { "type": "array" },
    "decisions": { "type": "array" },
    "risks": { "type": "array" },
    "limitations": { "type": "array" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
